# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Zero-cost map providers. After changing Netlify environment variables, redeploy the site.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_MAP_TILE_MAX_ZOOM=19
MAP_PROVIDER=leaflet
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
MAP_TILE_MAX_ZOOM=19
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CASMARA-CRM/1.0
NOMINATIM_EMAIL=
GEOCODING_REQUEST_INTERVAL_MS=1100
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
PROSPECT_PROVIDER=osm
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
AI_PROVIDER=rules
EXTERNAL_NAVIGATION_ENABLED=true

# Voice visit notes (server side only - never expose these to the browser).
# Without OPENAI_API_KEY the recorder still works but the note must be filled
# in by hand, and the transcript is always preserved.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_STRUCTURE_MODEL=gpt-4o-mini
