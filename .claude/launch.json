{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-client",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5173",
        "--host",
        "0.0.0.0"
      ],
      "port": 5173
    },
    {
      "name": "express-api",
      "runtimeExecutable": "/usr/local/bin/npm",
      "runtimeArgs": [
        "run",
        "server:dev"
      ],
      "port": 3035
    },
    {
      "name": "dev-all",
      "runtimeExecutable": "/usr/local/bin/npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "vite-preview",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173
    }
  ]
}